<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>뉴로스</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Google 로그인 URL Scheme -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID</string>
			</array>
		</dict>

		<!-- Kakao 로그인 URL Scheme -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakaoYOUR_KAKAO_NATIVE_APP_KEY</string>
			</array>
		</dict>

		<!-- Naver 로그인 URL Scheme -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>naverloginYOUR_NAVER_CONSUMER_KEY</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- 실제 AdMob 앱 ID로 교체 -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- 실제 Kakao 앱 키로 교체 -->
	<key>KAKAO_APP_KEY</key>
	<string>YOUR_KAKAO_NATIVE_APP_KEY</string>

	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>storykompassauth</string>
		<string>kakaolink</string>
		<string>naversearchapp</string>
		<string>naversearchthirdlogin</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- xcconfig에서 서버 주소를 주입 -->
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>

	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 개발 환경에서는 HTTP 요청 허용 -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>

		<!-- 로컬 네트워크 접근 허용 -->
		<key>NSAllowsLocalNetworking</key>
		<true/>

		<!-- 개발/필수 도메인 예외 설정 -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>storage.googleapis.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>

			<!-- 개발 서버 IP로 교체 -->
			<key>YOUR_DEV_SERVER_IP</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string></string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>하루 두 번 문해력 루틴을 잊지 않고 챙길 수 있도록 알림을 보내드립니다.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>관심사에 맞는 개인 맞춤형 광고를 제공하는 데 사용됩니다.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Pretendard-Regular.ttf</string>
		<string>Pretendard-Medium.ttf</string>
		<string>Pretendard-Bold.ttf</string>
		<string>Pretendard-ExtraBold.ttf</string>
		<string>Pretendard-SemiBold.ttf</string>
		<string>Roboto-Medium.ttf</string>
		<string>NanumSquareRoundEB.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>